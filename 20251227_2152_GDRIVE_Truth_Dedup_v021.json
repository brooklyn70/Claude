    {
      "parameters": {
        "jsCode": "const item = $input.first();\nconst loopItem = $('Loop Source Files').first().json;\nconst content = item.json?.data || '';\n\nif (!content || content.length < 10) {\n  console.log('Skipping empty source file:', loopItem.name);\n  return [];\n}\n\n// Split into paragraphs\nconst paragraphs = content\n  .split(/\\n\\s*\\n/)\n  .map(p => p.trim())\n  .filter(p => p.length > 50);\n\nconsole.log('Source paragraphs from', loopItem.name, ':', paragraphs.length);\n\nreturn paragraphs.map((para, idx) => ({\n  json: {\n    sourceFile: loopItem.name,\n    fileId: loopItem.id,\n    paragraphIndex: idx,\n    paragraphText: para,\n    isTruth: false\n  }\n}));"
      },
      "id": "split-source-paragraphs-012",
      "name": "Split Source to Paragraphs",
      "type": "n8n-nodes-base.code",
      "position": [
        1440,
        400
      ],
      "typeVersion": 2
    },
    {
      "parameters": {
        "jsCode": "// Get truth paragraphs from Collect All Truth Paragraphs node\nconst truthData = $('Collect All Truth Paragraphs').first().json.data || [];\nconst truthParagraphs = truthData.map(t => t.paragraphText);\n\nconsole.log('Truth set size:', truthParagraphs.length);\n\n// Get current source paragraph\nconst sourcePara = $input.first().json;\n\n// Compare function (90% similarity threshold)\nfunction areSimilar(str1, str2, threshold = 0.9) {\n  const words1 = new Set(str1.toLowerCase().split(/\\s+/));\n  const words2 = new Set(str2.toLowerCase().split(/\\s+/));\n  const intersection = new Set([...words1].filter(w => words2.has(w)));\n  const union = new Set([...words1, ...words2]);\n  const similarity = union.size ? intersection.size / union.size : 0;\n  return similarity >= threshold;\n}\n\n// Check if this source paragraph is similar to ANY truth paragraph\nconst isDuplicate = truthParagraphs.some(truthPara => areSimilar(sourcePara.paragraphText, truthPara, 0.9));\n\nif (isDuplicate) {\n  console.log('DUPLICATE found, skipping:', sourcePara.sourceFile);\n  return []; // Skip duplicates\n}\n\n// Keep unique paragraphs\nconsole.log('UNIQUE paragraph from:', sourcePara.sourceFile);\nreturn [{ json: sourcePara }];"
      },
      "id": "compare-to-truth-013",
      "name": "Compare to Truth",
      "type": "n8n-nodes-base.code",
      "position": [
        1640,
        400
      ],
