    {
      "parameters": {
        "jsCode": "const item = $input.first();\nconst loopItem = $('Loop Truth Files').first().json;\nconst content = item.json?.data || '';\n\nif (!content || content.length < 10) {\n  console.log('Skipping empty truth file:', loopItem.name);\n  return [];\n}\n\n// Split into paragraphs\nconst paragraphs = content\n  .split(/\\n\\s*\\n/)\n  .map(p => p.trim())\n  .filter(p => p.length > 50);\n\nconsole.log('Truth paragraphs from', loopItem.name, ':', paragraphs.length);\n\nreturn paragraphs.map((para, idx) => ({\n  json: {\n    sourceFile: loopItem.name,\n    fileId: loopItem.id,\n    paragraphIndex: idx,\n    paragraphText: para,\n    isTruth: true\n  }\n}));"
