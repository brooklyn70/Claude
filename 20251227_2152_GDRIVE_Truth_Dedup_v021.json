      "id": "collect-unique-014",
      "name": "Collect Unique Paragraphs",
      "type": "n8n-nodes-base.aggregate",
      "position": [
        1240,
        600
      ],
      "typeVersion": 1
    },
    {
      "parameters": {
        "jsCode": "const uniqueData = $input.first().json.data || [];\n\nconsole.log('\u2705 Building final document with', uniqueData.length, 'unique paragraphs');\n\nlet content = 'L.A. Dolce Vita - Unique Content from n8n Sources\\n';\ncontent += '='.repeat(50) + '\\n\\n';\ncontent += `Found ${uniqueData.length} unique paragraphs not in _essentials folder.\\n\\n`;\ncontent += '='.repeat(50) + '\\n\\n';\n\n// Group by source file\nconst byFile = {};\nuniqueData.forEach(item => {\n  const file = item.sourceFile || 'Unknown';\n  if (!byFile[file]) byFile[file] = [];\n  byFile[file].push(item.paragraphText);\n});\n\n// Build output\nObject.keys(byFile).sort().forEach(fileName => {\n  content += `\\n### FROM: ${fileName} ###\\n\\n`;\n  byFile[fileName].forEach(para => {\n    content += para + '\\n\\n---\\n\\n';\n  });\n});\n\nreturn [{ json: { content, fileName: 'n8n_unique_content' } }];"
      },
